{
  "name": "journal-editor",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "examples": "node scripts/examples.mjs",
    "wasm": "wasm-pack build ../wasm --target web --release --out-dir ../frontend/wasm-pkg --out-name scribe_wasm",
    "wasm:dev": "wasm-pack build ../wasm --target web --dev --out-dir ../frontend/wasm-pkg --out-name scribe_wasm",
    "start": "npm run examples && npm run wasm && ng serve",
    "serve": "npm run examples && ng serve",
    "build": "npm run examples && npm run wasm && ng build",
    "watch": "ng build --watch --configuration development",
    "test": "npm run examples && ng test"
  },
  "private": true,
  "engines": {
    "node": "^24.15.0"
  },
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "fflate": "^0.8.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.0",
    "@webgpu/types": "^0.1.74",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}

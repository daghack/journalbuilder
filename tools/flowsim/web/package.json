{
  "name": "flowsim",
  "private": true,
  "version": "0.1.0",
  "description": "A 2-D flow simulator that traces particle paths and exports them as SVG.",
  "type": "module",
  "scripts": {
    "wasm": "wasm-pack build ../sim --target web --release --out-dir ../web/wasm-pkg --out-name flowsim --features bindings",
    "wasm:dev": "wasm-pack build ../sim --target web --dev --out-dir ../web/wasm-pkg --out-name flowsim --features bindings",
    "dev": "npm run wasm && vite",
    "serve": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run wasm && tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "typescript": "~6.0.2",
    "vite": "^8.3.6"
  }
}
